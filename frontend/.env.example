# ============================================================================
# SuperUI Frontend Environment Configuration
# ============================================================================
# Copy this file to .env for local development, and configure the
# matching variables in Vercel for production deployments.
#
# Local development runs against a Node.js backend on your machine.
# Production builds talk to the hosted backend (no localhost fallback).
# ============================================================================

# --- Local development (used when running `npm run dev`) ---
VITE_API_BASE_URL=http://localhost:5000
VITE_SOCKET_URL=http://localhost:5000

# --- Supabase Auth (shared across dev + prod) ---
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ============================================================================
# PRODUCTION (Vercel) - set these in the Vercel dashboard, NOT in this file.
# Vite reads VITE_* from process.env at build time on Vercel.
# ============================================================================
# VITE_API_BASE_URL=https://superui-lanch-backend.onrender.com
# VITE_SOCKET_URL=https://superui-lanch-backend.onrender.com
# VITE_SUPABASE_URL=https://uktbrdmkraojcorvzqnj.supabase.co
# VITE_SUPABASE_ANON_KEY=<your-production-anon-key>
