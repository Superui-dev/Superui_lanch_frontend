# Frontend Environment Configuration
# Vite requires all env vars to be prefixed with VITE_

# Backend API URL (used by axios client and direct API calls)
VITE_API_URL=http://localhost:5000

# Socket.io Server URL (used for real-time admin dashboard)
VITE_SOCKET_URL=http://localhost:5000

# Frontend Origin (used for constructing absolute URLs)
VITE_FRONTEND_ORIGIN=http://localhost:5173

# App Environment
VITE_APP_ENV=production

